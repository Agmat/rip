# Copy to backend/.env and fill in.
#
# Use the Neon "dev" branch here (a weekly-reset copy of prod), never production.
# Postgres (Neon) — from https://console.neon.tech → your project → Dashboard → "Connection string".
# DATABASE_URL: the direct connection (for migrations / long-lived connections).
# DATABASE_URL_POOLED: the same string with the "-pooler" host (toggle "Connection pooling" in the Neon UI).
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require&channel_binding=require"
